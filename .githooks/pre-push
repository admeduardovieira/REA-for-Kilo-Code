#!/bin/sh
# REA for Kilo Code - pre-push hook (hardened)
echo [REA] Running pre-push validation...
REPO_ROOT=$(git rev-parse --show-toplevel)
VALIDATOR=$REPO_ROOT/scripts/validate-fork.ps1
if command -v pwsh >/dev/null 2>&1; then
  PS_BIN=pwsh
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN=powershell
else
  echo [REA] WARNING: PowerShell not found. Skipping strict fork validation. Validation requires PowerShell.
  exit 1
fi
BASE_REF=origin/master
if ! git rev-parse --verify --quiet origin/master >/dev/null 2>&1; then
  if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    BASE_REF=origin/main
  else
    BASE_REF=HEAD~1
  fi
fi
$PS_BIN -NoProfile -ExecutionPolicy Bypass -Command "& { & $VALIDATOR -ForkPath $REPO_ROOT -BaseRef $BASE_REF -ApprovedPaths @('scripts/validate-fork.ps1', '.githooks/pre-push', '.github/workflows/rea-validation.yml', 'AGENTS.md', 'README.md', 'tests/test_script.ps1', 'tests/test_structure.ps1') }"
RC=$?
if [ $RC -ne 0 ]; then
  echo [REA] ERROR: Fork validation failed. Push blocked.
  exit 1
fi
echo [REA] pre-push validation passed.
exit 0
