#!/bin/sh
set -eu

echo "[REA] Running pre-push validation..."

REPO_ROOT=$(git rev-parse --show-toplevel)

case "$REPO_ROOT" in
  /[a-zA-Z]/*)
    REPO_ROOT_WIN=$(printf '%s\n' "$REPO_ROOT" | sed -E 's|^/([a-zA-Z])/|\1:/|')
    ;;
  *)
    REPO_ROOT_WIN="$REPO_ROOT"
    ;;
esac

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN=pwsh
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN=powershell
else
  echo "[REA] BLOCKED: PowerShell unavailable"
  exit 1
fi

# Compare against the remote audit branch
BASE_REF=origin/audit-final

if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
  echo "[REA] BLOCKED: Cannot determine valid audit baseline"
  exit 1
fi
APPROVED_PATHS="scripts/validate-fork.ps1,.githooks/pre-push,.github/workflows/rea-validation.yml,AGENTS.md,README.md,tests/test_script.ps1,tests/test_structure.ps1"

"$PS_BIN" -NoProfile -NonInteractive -ExecutionPolicy Bypass \
  -File "$REPO_ROOT_WIN/scripts/validate-fork.ps1" \
  -ForkPath "$REPO_ROOT_WIN" \
  -BaseRef "$BASE_REF" \
  -ApprovedPaths "$APPROVED_PATHS" < /dev/null

RC=$?

if [ "$RC" -ne 0 ]; then
  echo "[REA] BLOCKED: Validation failed"
  exit 1
fi

echo "[REA] Validation passed"
exit 0
